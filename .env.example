# Database
DATABASE_URL=

# Object Storage (MinIO)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=

# Langfuse (Observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Model Providers (Agno-abstracted)
OPENAI_API_KEY=
# Set OPENAI_BASE_URL to route all OpenAI-provider requests through a
# LiteLLM proxy. Leave empty to call OpenAI directly.
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Model Configuration (format: provider/model_id)
# Available providers: openai, anthropic, google
HOLODECK_DEFAULT_MODEL=
# Per-agent overrides (leave empty to use HOLODECK_DEFAULT_MODEL):
HOLODECK_MODEL_SHOWRUNNER=
HOLODECK_MODEL_HEAD_WRITER=
HOLODECK_MODEL_STAFF_WRITER=
HOLODECK_MODEL_CANON_HISTORIAN=
HOLODECK_MODEL_CRITIC=
HOLODECK_MODEL_EVALUATOR=

# Application
HOLODECK_DEFAULT_MODE=
HOLODECK_MAX_FEEDBACK_ITERATIONS=
HOLODECK_QUALITY_GATE_THRESHOLD=
HOLODECK_CONFLICT_ESCALATION_THRESHOLD=
HOLODECK_HUMAN_APPROVAL_TIMEOUT_SECONDS=

# ElevenLabs Voice Cloning (feature 006)
# Get your API key from https://elevenlabs.io → Account Settings
ELEVENLABS_API_KEY=
# Model: eleven_monolingual_v1 (English, free tier) or eleven_multilingual_v2
ELEVENLABS_VOICE_MODEL=eleven_monolingual_v1
# Stability [0.0–1.0]: higher = more consistent delivery, less expressive variation
ELEVENLABS_VOICE_STABILITY=0.5
# Similarity boost [0.0–1.0]: higher = closer to the original voice sample
ELEVENLABS_SIMILARITY_BOOST=0.75
# Speaker boost: true = better audio quality (uses more monthly character credits)
ELEVENLABS_USE_SPEAKER_BOOST=false

# Image Generation (feature 007)
# Provider: replicate (recommended), stability, huggingface, svgonly (no AI)
IMAGE_PROVIDER=svgonly
# Replicate: get API key from https://replicate.com → Account Settings → API Keys
REPLICATE_API_KEY=
# Model: black-forest-labs/flux-2-pro (fast, cheap) or stability-ai/sdxl (slower, higher quality)
REPLICATE_MODEL=black-forest-labs/flux-2-pro
# Output dimensions (must be <= 2048 on both axes)
IMAGE_GEN_WIDTH=1280
IMAGE_GEN_HEIGHT=720
# Style preset: illustrated (default, cheap), cinematic, photorealistic, animated
IMAGE_GEN_STYLE=illustrated
# Hard cap on AI API calls per production run (0 = unlimited). SVG fallback when exhausted.
AI_BUDGET_LIMIT=25
